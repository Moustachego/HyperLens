# Build artifacts and compiled binaries
target/
*.o
*.out
*.exe
src/HyperLens
src/HyperLens.debug
src/*.debug

# VSCode settings
.vscode/

# GitHub workflow files (excluding copilot-instructions.md which is useful)
.github/*
!.github/copilot-instructions.md

# Output files generated by the software demo
src/output/*
!src/output/.gitkeep

# Large ACL rule datasets; keep only the checked-in test fixture
src/ACL_rules/*/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Conda environment
*.egg-info/
.conda/

# CMake build files (already covered by target/ but being explicit)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Editor backup files
*~
*.swp
*.swo
*.bak
.DS_Store

# VS Code Local History (auto-generated, not version controlled)
.history/

# Log files
*.log
logs/

# Temporary files
*.tmp
*.temp

# Optional P4 build outputs
p4/build/
build/
