# Build artifacts and compiled binaries
target/
*.o
*.out
*.exe
src/HyperLens
src/HyperLens.debug
src/*.debug

# VSCode settings
.vscode/

# GitHub workflow files (excluding copilot-instructions.md which is useful)
.github/*
!.github/copilot-instructions.md

# Output files (generated tables)
src/output/*.txt

# ACL rules files (exclude subfolders, keep only test.rules and acl_10k.rules)
src/ACL_rules/*/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Conda environment
*.egg-info/
.conda/

# CMake build files (already covered by target/ but being explicit)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Editor backup files
*~
*.swp
*.swo
*.bak
.DS_Store

# Log files
*.log
logs/

# Temporary files
*.tmp
*.temp
