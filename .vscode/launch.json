{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug P4Lens (F5)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/src/P4Lens.debug",
            "args": ["src/ACL_rules/test.rules"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": true,
                "trace": true,
                "traceResponse": true,
                "programOutput": true
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set disassembly flavor to intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Set breakpoint after rule loading",
                    "text": "-break-insert src/P4Lens.cpp:57",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "Build: P4Lens (g++-11) - Debug"
        }
    ]
}