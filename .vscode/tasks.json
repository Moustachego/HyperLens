{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ build all src",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "${workspaceFolder}/src/Parallel-Port-Lookup.cpp",
                "${workspaceFolder}/src/input.cpp",
                "${workspaceFolder}/src/Dependent-Set-Prefix-Lookup.cpp",
                "-o",
                "${workspaceFolder}/src/Parallel-Port-Lookup"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Compile all cpp files in src"
        },
        {
            "type": "shell",
            "label": "C/C++: g++-11 生成活动文件",
            "command": "/usr/bin/g++-11",
            "args": [
                "-std=c++17",
                "-fdiagnostics-color=always",
                "-g",
                "-DCOMPILE_AS_LIB",
                "${workspaceFolder}/src/Parallel-Port-Lookup.cpp",
                "${workspaceFolder}/src/input.cpp",
                "${workspaceFolder}/src/Dependent-Set-Prefix-Lookup.cpp",
                "-o",
                "${workspaceFolder}/src/Parallel-Port-Lookup"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build Parallel-Port-Lookup (links input.cpp and Dependent-Set-Prefix-Lookup.cpp)"
        }
    ]
}