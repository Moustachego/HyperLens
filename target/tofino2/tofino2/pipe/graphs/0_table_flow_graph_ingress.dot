digraph ingress {
ip_table_0 [ shape=record, style="filled", fillcolor=cornsilk, label="ip_table_0\l\l
M:\l
 vrf_0\l
 p.ipv4.src\l
 p.ipv4.dst\l
 p.ipv4.proto\l
\lW:\l
 ig_md.Group_id\l
 ig_intr_md_for_dprsr.drop_ctl\l
 ig_intr_md_for_dprsr.drop_ctl.$valid\l
 "];
src_tcam_table_0 [ shape=record, style="filled", fillcolor=cornsilk, label="src_tcam_table_0\l\l
M:\l
 ig_md.Group_id\l
 p.udp.sport\l
\lW:\l
 ig_md.Group_id2\l
 "];
tbl_drop_1 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_drop_1\l\l
W:\l
 ig_intr_md_for_dprsr.drop_ctl\l
 ig_intr_md_for_dprsr.drop_ctl.$valid\l
 "];
tbl_act [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_act\l\l
W:\l
 src_tcam_match_0\l
 "];
src_sram_table_0 [ shape=record, style="filled", fillcolor=cornsilk, label="src_sram_table_0\l\l
M:\l
 ig_md.Group_id\l
 p.udp.sport\l
\lW:\l
 ig_md.Group_id2\l
 "];
tbl_act_1 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_act_1\l\l
W:\l
 src_sram_match_0\l
 "];
cond_3 [ shape=record, style="filled", fillcolor=cornsilk, label="src_tcam_match_0 || src_sram_match_0\l\l
 "];
dst_tcam_table_0 [ shape=record, style="filled", fillcolor=cornsilk, label="dst_tcam_table_0\l\l
M:\l
 ig_md.Group_id2\l
 p.udp.dport\l
\lW:\l
 ig_intr_md_for_tm.ucast_egress_port\l
 ig_intr_md_for_tm.ucast_egress_port.$valid\l
 ig_intr_md_for_dprsr.drop_ctl\l
 ig_intr_md_for_dprsr.drop_ctl.$valid\l
 "];
tbl_drop_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_drop_0\l\l
W:\l
 ig_intr_md_for_dprsr.drop_ctl\l
 ig_intr_md_for_dprsr.drop_ctl.$valid\l
 "];
tbl_act_3 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_act_3\l\l
W:\l
 dst_tcam_match_0\l
 "];
dst_sram_table_0 [ shape=record, style="filled", fillcolor=cornsilk, label="dst_sram_table_0\l\l
M:\l
 ig_md.Group_id2\l
 p.udp.dport\l
\lW:\l
 ig_intr_md_for_tm.ucast_egress_port\l
 ig_intr_md_for_tm.ucast_egress_port.$valid\l
 ig_intr_md_for_dprsr.drop_ctl\l
 ig_intr_md_for_dprsr.drop_ctl.$valid\l
 "];
tbl_act_5 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_act_5\l\l
W:\l
 dst_sram_match_0\l
 "];
cond_4 [ shape=record, style="filled", fillcolor=cornsilk, label="!dst_tcam_match_0 && !dst_sram_match_0\l\l
 "];
tbl_drop [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_drop\l\l
W:\l
 ig_intr_md_for_dprsr.drop_ctl\l
 ig_intr_md_for_dprsr.drop_ctl.$valid\l
 "];
    PARSER -> ip_table_0
    ip_table_0 -> src_tcam_table_0
    PARSER -> ip_table_0
    ip_table_0 -> tbl_drop_1
    src_tcam_table_0 -> tbl_act
    src_tcam_table_0 -> src_sram_table_0
    tbl_act -> src_sram_table_0
    src_sram_table_0 -> tbl_act_1
    src_sram_table_0 -> cond_3
    tbl_act_1 -> cond_3
    cond_3 -> dst_tcam_table_0
    cond_3 -> tbl_drop_0
    dst_tcam_table_0 -> tbl_act_3
    dst_tcam_table_0 -> dst_sram_table_0
    tbl_act_3 -> dst_sram_table_0
    dst_sram_table_0 -> tbl_act_5
    dst_sram_table_0 -> cond_4
    tbl_act_5 -> cond_4
    cond_4 -> tbl_drop
    cond_4 -> DEPARSER
    tbl_drop -> DEPARSER
    tbl_drop_0 -> DEPARSER
    tbl_drop_1 -> DEPARSER
}
