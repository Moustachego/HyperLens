version:
  version: 1.0.1
  run_id: "ebb2921b54f74acd"
  target: Tofino2
error_mode: propagate_and_disable
phv ingress:
  ig_intr_md_for_dprsr.mirror_type.$valid: B1(0)
  p.ipv4.proto: MB6
  p.ipv4.src: MW2
  p.ipv4.dst: MW1
  p.udp.sport: MW0(16..31)
  p.udp.dport: MW0(0..15)
  vrf_0: {  stage 0: MH1 } 
  ig_md.Group_id: {  stage 1..2: MH2(0..8) } 
  ig_md.Group_id2: {  stage 2..4: MH3(0..8) } 
  ig_intr_md_for_dprsr.drop_ctl: {  stage 1..20: MB5(0..2) } 
  ig_intr_md_for_dprsr.mirror_type: {  stage 20: MB4(0..3) } 
  ig_intr_md_for_dprsr.drop_ctl.$valid: {  stage 1..20: B1(1) } 
  src_tcam_match_0: {  stage 2..3: B1(7) } 
  src_sram_match_0: {  stage 3: MB1(0) } 
  ig_intr_md_for_tm.ucast_egress_port: {  stage 4..20: MH4(0..8) } 
  ig_intr_md_for_tm.ucast_egress_port.$valid: {  stage 4..20: B1(2) } 
  dst_tcam_match_0: {  stage 4..5: MB2(0) } 
  dst_sram_match_0: {  stage 5: MB3(0) } 
  $tmp2: {  stage 20: B0 } 
  p.ethernet.$valid: B1(3)
  p.ipv4.$valid: B1(4)
  p.tcp.$valid: B1(5)
  p.udp.$valid: B1(6)
  context_json:
    MB1:
    - { name : src_sram_match_0, live_start : 3, live_end : 3, mutually_exclusive_with: [  ] }
    MB2:
    - { name : dst_tcam_match_0, live_start : 4, live_end : 5, mutually_exclusive_with: [  ] }
    MB3:
    - { name : dst_sram_match_0, live_start : 5, live_end : 5, mutually_exclusive_with: [  ] }
    MB4:
    - { name : ig_intr_md_for_dprsr.mirror_type, live_start : deparser, live_end : deparser, mutually_exclusive_with: [  ] }
    MB5:
    - { name : ig_intr_md_for_dprsr.drop_ctl, live_start : 1, live_end : deparser, mutually_exclusive_with: [  ] }
    MB6:
    - { name : p.ipv4.proto, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    MH1:
    - { name : vrf_0, live_start : 0, live_end : 0, mutually_exclusive_with: [  ] }
    MH2:
    - { name : ig_md.Group_id, live_start : 1, live_end : 2, mutually_exclusive_with: [  ] }
    MH3:
    - { name : ig_md.Group_id2, live_start : 2, live_end : 4, mutually_exclusive_with: [  ] }
    MH4:
    - { name : ig_intr_md_for_tm.ucast_egress_port, live_start : 4, live_end : deparser, mutually_exclusive_with: [  ] }
    MW0:
    - { name : p.udp.sport, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : p.udp.dport, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    MW1:
    - { name : p.ipv4.dst, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    MW2:
    - { name : p.ipv4.src, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    B0:
    - { name : $tmp2, live_start : deparser, live_end : deparser, mutually_exclusive_with: [  ] }
    B1:
    - { name : ig_intr_md_for_dprsr.mirror_type.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : ig_intr_md_for_dprsr.drop_ctl.$valid, live_start : 1, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : src_tcam_match_0, live_start : 2, live_end : 3, mutually_exclusive_with: [  ] }
    - { name : ig_intr_md_for_tm.ucast_egress_port.$valid, live_start : 4, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : p.ethernet.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : p.ipv4.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : p.tcp.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : p.udp.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
phv egress:
  eg_intr_md_for_dprsr.mirror_io_select: MB0(4)
  eg_intr_md_for_dprsr.mirror_io_select.$valid: MB0(0)
  eg_intr_md.egress_port: MH0(0..8)
  eg_intr_md.egress_port.$valid: MB0(1)
  p.ethernet.$valid: MB0(2)
  p.ipv4.$valid: MB0(3)
  context_json:
    MB0:
    - { name : eg_intr_md_for_dprsr.mirror_io_select, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : eg_intr_md_for_dprsr.mirror_io_select.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : eg_intr_md.egress_port.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : p.ethernet.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : p.ipv4.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    MH0:
    - { name : eg_intr_md.egress_port, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
parser ingress:
  start: $entry_point.start
  bitwise_or: [ B1 ]
  hdr_len_adj: 32
  states:
    $entry_point.start:
      *:
        B1: 9
            # - value 1 -> B1 bit[0]: ingress::ig_intr_md_for_dprsr.mirror_type.$valid
            # - value 1 -> B1 bit[3]: ingress::p.ethernet.$valid
        shift: 32
        buf_req: 32
        next: $entry_point.start.$oob_stall_0
    $entry_point.start.$oob_stall_0:
      *:
        load: { byte0 : 12, byte1 : 13 }
        buf_req: 14
        next: $entry_point.start.$split_0
    $entry_point.start.$split_0:
      match: [ byte0, byte1 ]
      0x0800:
        clot 1 :
          start: 0
          length: 14
        load: { byte0 : 23 }
        shift: 14
        buf_req: 24
        next: parse_ip
      0x****:
        clot 1 :
          start: 0
          length: 14
        shift: 14
        buf_req: 14
        next: end
    parse_ip:
      match: [ byte0 ]
      0x06:
        9: MB6  # ingress::p.ipv4.proto
        12..15: MW2  # ingress::p.ipv4.src
        16..19: MW1  # ingress::p.ipv4.dst
        B1: 16  # value 1 -> B1 bit[4]: ingress::p.ipv4.$valid
        clot 2 :
          start: 0
          length: 20
        load: { byte0 : 22, byte1 : 23 }
        shift: 20
        buf_req: 24
        next: parse_tcp
      0x11:
        9: MB6  # ingress::p.ipv4.proto
        12..15: MW2  # ingress::p.ipv4.src
        16..19: MW1  # ingress::p.ipv4.dst
        B1: 16  # value 1 -> B1 bit[4]: ingress::p.ipv4.$valid
        clot 2 :
          start: 0
          length: 20
        load: { byte0 : 22, byte1 : 23 }
        shift: 20
        buf_req: 24
        next: parse_udp
      0x**:
        9: MB6  # ingress::p.ipv4.proto
        12..15: MW2  # ingress::p.ipv4.src
        16..19: MW1  # ingress::p.ipv4.dst
        B1: 16  # value 1 -> B1 bit[4]: ingress::p.ipv4.$valid
        clot 2 :
          start: 0
          length: 20
        shift: 20
        buf_req: 20
        next: end
    parse_tcp:
      match: [ byte0, byte1 ]
      0x****:
        B1: 32  # value 1 -> B1 bit[5]: ingress::p.tcp.$valid
        clot 0 :
          start: 0
          length: 20
        shift: 20
        buf_req: 20
        next: end
    parse_udp:
      match: [ byte0, byte1 ]
      0x****:
        0..3: MW0
            # - bit[0..15] -> MW0 bit[31..16]: ingress::p.udp.sport
            # - bit[16..31] -> MW0 bit[15..0]: ingress::p.udp.dport
        B1: 64  # value 1 -> B1 bit[6]: ingress::p.udp.$valid
        clot 3 :
          start: 0
          length: 8
        shift: 8
        buf_req: 8
        next: end
deparser ingress:
  dictionary:
    clot 1:
      pov: p.ethernet.$valid
    clot 2:
      pov: p.ipv4.$valid
    clot 3:
      pov: p.udp.$valid
    clot 0:
      pov: p.tcp.$valid
  egress_unicast_port: { MH4(0..8): B1(2) }  # bit[8..0]: ingress::ig_intr_md_for_tm.ucast_egress_port if ingress::ig_intr_md_for_tm.ucast_egress_port.$valid
  drop_ctl: { MB5(0..2): B1(1) }  # bit[2..0]: ingress::ig_intr_md_for_dprsr.drop_ctl if ingress::ig_intr_md_for_dprsr.drop_ctl.$valid
  mirror:
    select: { MB4(0..3): B1(0) }  # bit[3..0]: ingress::ig_intr_md_for_dprsr.mirror_type
    0:
      - B0  # ingress::$tmp2
parser egress:
  start: $entry_point.start
  bitwise_or: [ MB0 ]
  hdr_len_adj: 28
  meta_opt: 8191
  states:
    $entry_point.start:
      *:
        0..1: MH0  # bit[7..15] -> MH0 bit[8..0]: egress::eg_intr_md.egress_port
        MB0: 23
            # - value 1 -> MB0 bit[4]: egress::eg_intr_md_for_dprsr.mirror_io_select
            # - value 1 -> MB0 bit[0]: egress::eg_intr_md_for_dprsr.mirror_io_select.$valid
            # - value 1 -> MB0 bit[1]: egress::eg_intr_md.egress_port.$valid
            # - value 1 -> MB0 bit[2]: egress::p.ethernet.$valid
        clot 1 :
          start: 28
          length: 14
        intr_md: 9
        shift: 32
        buf_req: 32
        next: $entry_point.start.$oob_stall_1
    $entry_point.start.$oob_stall_1:
      *:
        # clot 1 (spilled)
        load: { byte0 : 8, byte1 : 9 }
        shift: 10
        buf_req: 10
        next: $entry_point.start.$split_0
    $entry_point.start.$split_0:
      match: [ byte0, byte1 ]
      0x0800:
        MB0: 8  # value 1 -> MB0 bit[3]: egress::p.ipv4.$valid
        clot 0 :
          start: 0
          length: 20
        shift: 20
        buf_req: 20
        next: end
      0x****:
        buf_req: 0
        next: end
deparser egress:
  dictionary:
    clot 1:
      pov: p.ethernet.$valid
    clot 0:
      pov: p.ipv4.$valid
  mirr_io_sel: { MB0(4..4): MB0(0) }  # bit[4]: egress::eg_intr_md_for_dprsr.mirror_io_select if egress::eg_intr_md_for_dprsr.mirror_io_select.$valid
  egress_unicast_port: { MH0(0..8): MB0(1) }  # bit[8..0]: egress::eg_intr_md.egress_port if egress::eg_intr_md.egress_port.$valid
stage 0 ingress:
  mpr_stage_id: 0
  mpr_bus_dep_glob_exec: 0x0
  mpr_bus_dep_long_brch: 0x0
  mpr_always_run: 0x1
  phase0_match SwitchIngressParser.$PORT_METADATA:
    p4:
      name: SwitchIngressParser.$PORT_METADATA
      size: 288
      preferred_match_type: exact
      match_type: exact
    size: 288
    p4_param_order:
      ig_intr_md.ingress_port: { type: exact, size: 9 }
    format: {ig_intr_md: 0..127}
    constant_value: 0
    actions:
      set_port_metadata:
      - handle: 0x20000000
      - p4_param_order: { ig_intr_md: 128 } 
  ternary_match ip_table_0 0:
    always_run: true
    p4: { name: SwitchIngress.ip_table, size: 1024 }
    p4_param_order: 
      vrf_0: { type: exact, size: 16, full_size: 16, key_name: "vrf" }
      p.ipv4.src: { type: ternary, size: 32, full_size: 32 }
      p.ipv4.dst: { type: ternary, size: 32, full_size: 32 }
      p.ipv4.proto: { type: exact, size: 8, full_size: 8 }
    row: [ 0, 1, 2, 5, 4, 3 ]
    bus: [ 0, 0, 0, 0, 0, 0 ]
    column:
    - 0
    - 0
    - 0
    - 0
    - 0
    - 0
    input_xbar:
      ternary group 0: { 0: p.ipv4.dst(0..7), 8: p.ipv4.src(8..15), 16: p.ipv4.dst(16..31), 32: p.ipv4.src(0..7) }
      ternary group 1: { 0: p.ipv4.src(16..31), 16: vrf_0, 32: p.ipv4.proto }
      byte group 0: { 0: p.ipv4.dst(8..15) }
    match:
    - { group: 0, byte_group: 0, byte_config: 0, dirtcam: 0x555 }
    - { group: 1, byte_group: 0, byte_config: 1, dirtcam: 0x555 }
    - { byte_config: 3, dirtcam: 0x0 }
    hit: [  src_tcam_table_0 ]
    miss:  tbl_drop_1
    indirect: ip_table_0$tind
  ternary_indirect ip_table_0$tind:
    row: 0
    bus: 0
    column: 2
    input_xbar:
      ternary group 0: { 0: p.ipv4.dst(0..7), 8: p.ipv4.src(8..15), 16: p.ipv4.dst(16..31), 32: p.ipv4.src(0..7) }
      ternary group 1: { 0: p.ipv4.src(16..31), 16: vrf_0, 32: p.ipv4.proto }
      byte group 0: { 0: p.ipv4.dst(8..15) }
    format: { action: 0..0, immediate: 1..9 }
    action_bus: { 32..33 : immediate(0..8) }
    instruction: ip_table_0$tind(action, $DEFAULT)
    actions:
      SwitchIngress.set_gid1(0, 1):
      - p4_param_order: { gid1: 9 }
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true }
      - handle: 0x20000001
      - next_table_miss:  tbl_drop_1
      - next_table: 0
      - { gid1: immediate(0..8) }
      - set MH2, gid1
      SwitchIngress.drop(1, 2):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true }
      - handle: 0x20000002
      - next_table_miss:  tbl_drop_1
      - next_table: 0
      - {  }
      - set ig_intr_md_for_dprsr.drop_ctl.$valid, 1
      - set MB5, 1
    default_action: SwitchIngress.drop
stage 1 ingress:
  dependency: match
  mpr_stage_id: 1
  mpr_bus_dep_glob_exec: 0x0
  mpr_bus_dep_long_brch: 0x0
  mpr_always_run: 0x0
  mpr_glob_exec_lut: 
    0: 0x3
    2: 0x4
  ternary_match src_tcam_table_0 0:
    p4: { name: SwitchIngress.src_tcam_table, size: 2048 }
    p4_param_order: 
      ig_md.Group_id: { type: exact, size: 9, full_size: 9 }
      p.udp.sport: { type: ternary, size: 16, full_size: 16 }
    row: [ 0, 1, 2, 3 ]
    bus: [ 0, 0, 0, 0 ]
    column:
    - 0
    - 0
    - 0
    - 0
    input_xbar:
      ternary group 0: { 0: ig_md.Group_id, 16: p.udp.sport }
    match:
    - { group: 0, byte_config: 3, dirtcam: 0x55 }
    hit: [ [ tbl_act, src_sram_table_0 ] ]
    miss:  src_sram_table_0
    indirect: src_tcam_table_0$tind
  ternary_indirect src_tcam_table_0$tind:
    row: 0
    bus: 0
    column: 2
    input_xbar:
      ternary group 0: { 0: ig_md.Group_id, 16: p.udp.sport }
    format: { action: 0..0, immediate: 1..9 }
    action_bus: { 32..33 : immediate(0..8) }
    instruction: src_tcam_table_0$tind(action, $DEFAULT)
    actions:
      SwitchIngress.set_gid2_from_tcam(0, 1):
      - p4_param_order: { gid2: 9 }
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true }
      - handle: 0x20000003
      - next_table_miss:  src_sram_table_0
      - next_table: 0
      - { gid2: immediate(0..8) }
      - set MH3, gid2
      SwitchIngress.nop(1, 0):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true }
      - handle: 0x20000004
      - next_table_miss:  src_sram_table_0
      - next_table: 0
      - {  }
    default_action: SwitchIngress.nop
  ternary_match tbl_act 1:
    p4: { name: tbl_act, hidden: true }
    hit: [  END ]
    miss:  END
    indirect: tbl_act$tind
  ternary_indirect tbl_act$tind:
    row: 0
    bus: 1
    format: { action: 0..0 }
    instruction: tbl_act$tind(action, $DEFAULT)
    actions:
      act(0, 2):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000005
      - next_table: 0
      - set src_tcam_match_0, 1
    default_action: act
  ternary_match tbl_drop_1 2:
    p4: { name: tbl_drop_1, hidden: true }
    hit: [  END ]
    miss:  END
    indirect: tbl_drop_1$tind
  ternary_indirect tbl_drop_1$tind:
    row: 1
    bus: 0
    format: { action: 0..0 }
    instruction: tbl_drop_1$tind(action, $DEFAULT)
    actions:
      SwitchIngress.drop(0, 4):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000013
      - next_table: 0
      - set ig_intr_md_for_dprsr.drop_ctl.$valid, 1
      - set MB5, 1
    default_action: SwitchIngress.drop
stage 2 ingress:
  dependency: match
  mpr_stage_id: 2
  mpr_bus_dep_glob_exec: 0x0
  mpr_bus_dep_long_brch: 0x0
  mpr_always_run: 0x0
  mpr_glob_exec_lut: 
    0: 0x3
  exact_match src_sram_table_0 0:
    p4: { name: SwitchIngress.src_sram_table, size: 4096 }
    p4_param_order: 
      ig_md.Group_id: { type: exact, size: 9, full_size: 9 }
      p.udp.sport: { type: exact, size: 11, full_size: 16, key_name: "ig_md.src_quotient", start_bit: 5 }
    row: 7
    bus: 0
    column: [ 2, 3, 4, 5 ]
    ways:
      - { group: 0, index: 0..9, select: 40..51 & 0x0, rams: [[7, 2]] }
      - { group: 0, index: 10..19, select: 40..51 & 0x0, rams: [[7, 3]] }
      - { group: 0, index: 20..29, select: 40..51 & 0x0, rams: [[7, 4]] }
      - { group: 0, index: 30..39, select: 40..51 & 0x0, rams: [[7, 5]] }
    input_xbar:
      exact group 0: { 0: ig_md.Group_id, 21: p.udp.sport(5..15) }
      hash 0:
        0..5: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ ig_md.Group_id(0..5)
        6: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ ig_md.Group_id(8)
        7..9: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ p.udp.sport(5..7)
        11..16: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ ig_md.Group_id(0..5)
        17: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ ig_md.Group_id(8)
        18..19: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ p.udp.sport(5..6)
        10: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ p.udp.sport(7)
        22..27: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ ig_md.Group_id(0..5)
        28: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ ig_md.Group_id(8)
        29: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ p.udp.sport(5)
        20..21: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ p.udp.sport(6..7)
        33..38: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ ig_md.Group_id(0..5)
        39: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ ig_md.Group_id(8)
        30..32: random(ig_md.Group_id(6..7), p.udp.sport(8..15)) ^ p.udp.sport(5..7)
      hash group 0:
        table: [0]
        seed: 0x9a9c47831a
    format: { action(0): 0..0, immediate(0): 4..12, version(0): 48..51, match(0): [ 54..55, 40..47 ], action(1): 1..1, immediate(1): 13..21, version(1): 64..67, match(1): [ 70..71, 56..63 ], action(2): 2..2, immediate(2): 22..30, version(2): 80..83, match(2): [ 86..87, 72..79 ], action(3): 3..3, immediate(3): 31..39, version(3): 96..99, match(3): [ 102..103, 88..95 ] }
    match: [ ig_md.Group_id(6..7), p.udp.sport(8..15) ]
    match_group_map: [ [ 0, 1, 2, 3 ] ]
    hit: [ [ tbl_act_1, dst_tcam_table_0 ] ]
    miss:  dst_tcam_table_0
    action_bus: { 32..33 : immediate(0..8) }
    instruction: src_sram_table_0(action, $DEFAULT)
    actions:
      SwitchIngress.set_src_bitmap(0, 1):
      - p4_param_order: { bitmap: 32, gid2: 9 }
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true }
      - handle: 0x20000006
      - next_table_miss:  dst_tcam_table_0
      - next_table: 0
      - { gid2_2: immediate(0..8), gid2: gid2_2 }
      - set MH3, gid2
      SwitchIngress.nop(1, 0):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true }
      - handle: 0x20000007
      - next_table_miss:  dst_tcam_table_0
      - next_table: 0
      - {  }
    default_action: SwitchIngress.nop
  ternary_match tbl_act_1 1:
    p4: { name: tbl_act_1, hidden: true }
    hit: [  END ]
    miss:  END
    indirect: tbl_act_1$tind
  ternary_indirect tbl_act_1$tind:
    row: 0
